{
  "name": "dsh-appdata-scanner",
  "version": "0.6.0",
  "description": "AppData 目录分析插件：左侧栏图标按需打开，以资源管理器式下钻浏览，显示每个目录的递归体积/生成软件/用途/可删建议；联网查询给出模型总结与带摘要来源（只读，不提供删除功能）",
  "type": "module",
  "main": "plugin/index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "appdata",
    "disk-usage",
    "windows",
    "cleanup",
    "cleaner"
  ],
  "files": [
    "plugin/",
    "src/",
    "knowledge/",
    "README.md",
    "INSTALL.md"
  ]
}
